<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    LinkForge 父 POM。

    模块划分与依赖规则见 docs/DECISIONS.md DR-009 / DR-018：
      app      → core + redirect + stats + admin
      redirect → core + stats
      stats    → core
      admin    → core + stats
      redirect → admin   ❌ 禁止
      admin    → redirect ❌ 禁止

    约定：
      - 版本统一由 spring-boot-starter-parent 管理，子模块**不写版本号**。
      - spring-boot-maven-plugin 只出现在 linkforge-app（可执行 jar），其它模块产出普通 jar。
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.8</version>
    <relativePath/>
  </parent>

  <groupId>com.linkforge</groupId>
  <artifactId>linkforge-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>LinkForge</name>
  <description>分布式短链平台 —— 长链换短码、302 跳转、异步统计</description>

  <modules>
    <module>linkforge-core</module>
    <module>linkforge-redirect</module>
    <module>linkforge-stats</module>
    <module>linkforge-admin</module>
    <module>linkforge-app</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 依赖版本（Boot 未管理的才需要显式声明） -->
    <archunit.version>1.3.0</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 本项目模块 -->
      <dependency>
        <groupId>com.linkforge</groupId>
        <artifactId>linkforge-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.linkforge</groupId>
        <artifactId>linkforge-redirect</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.linkforge</groupId>
        <artifactId>linkforge-stats</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.linkforge</groupId>
        <artifactId>linkforge-admin</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 架构约束测试：把 DR-018 的依赖规则变成可执行的测试 -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
