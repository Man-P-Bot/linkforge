<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>linkforge-app</artifactId>
  <name>LinkForge :: App</name>
  <description>启动与装配：可执行 jar、配置、健康检查</description>

  <!--
    依赖规则（docs/DECISIONS.md DR-018）：
      app → core + redirect + stats + admin   ✅（app 是唯一允许依赖全部模块的模块）
  -->
  <dependencies>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-redirect</artifactId>
    </dependency>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-stats</artifactId>
    </dependency>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-admin</artifactId>
    </dependency>

    <!--
      Flyway 的 MySQL 支持：Flyway 10+ 已把它从 flyway-core 拆成独立模块，
      只加 flyway-core 会在启动时报 "Unsupported Database: MySQL 8.4"（docs/DECISIONS.md DR-021 讨论）。
      版本由 spring-boot-starter-parent 管理，与 Boot 内置的 Flyway 保持一致。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- MySQL 驱动：数据源在 linkforge-app 配置，因此驱动也由本模块提供 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- 架构约束测试所需（版本由父 POM 的 dependencyManagement 管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers MySQL：让仓储层集成测试**不依赖宿主机 MySQL**。

      ⚠️ 为什么要引这个（阶段 4 前置收口）：
        原来的 StatsRepositoryMyBatisTest 依赖宿主机上手工建的 linkforge_test 库
        + TEST_MYSQL_PASSWORD 环境变量。三个问题：
          ① 干净环境（CI / 新克隆）跑不了 —— 库不存在、凭据没有；
          ② 每次跑都连同一个库 —— 并行构建会互相污染（测试类都有 @Transactional
             回滚，但 DDL 迁移不是事务）；
          ③ 「测试环境与生产环境是否一致」不可控 —— 宿主机上的 MySQL 是什么版本？
        Testcontainers 让这些全部消失：每个测试类起一个**一次性** MySQL 8.4 容器，
        版本与生产镜像严格一致，用完即弃。

      ⚠️ scope=test：绝不进生产依赖树。
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 只有本模块产出可执行 jar，其它模块是普通 jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.linkforge.app.LinkForgeApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
