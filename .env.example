# LinkForge 本地环境变量
#
# 用法：复制本文件为 .env，按需修改后执行 docker compose up -d
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# ⚠️ .env 已被 .gitignore 忽略，禁止提交。本文件只放占位值，不放真实密钥。

# ---------- MySQL 8.4 ----------
# 仅本地开发使用；生产环境必须更换为强密码
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=linkforge
MYSQL_USER=linkforge
MYSQL_PASSWORD=change_me_app_password
# 宿主机映射端口。本机 MySQL80 服务已占用 3306，故改用 3307 避让。
# 容器内部端口恒为 3306；compose 网络内应用连接地址为 mysql:3306。
MYSQL_PORT=3307

# ---------- Redis 7.4 ----------
REDIS_PORT=6379

# ---------- 应用（第 1 周起使用）----------
# Location / shortUrl 拼接用的对外基地址；缺失时应用启动失败（见 docs/DECISIONS.md DR-014）
SHORTLINK_BASE_URL=http://localhost:8080
APP_PORT=8080

# 后台接口鉴权 Token；仅本地开发占位值，禁止用于任何真实环境
ADMIN_API_TOKEN=change_me_local_dev_token

# 限流阈值（见 docs/API.md §11）
RATE_LIMIT_REDIRECT_PER_SEC=20
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_QUERY_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=30

# 缓存 TTL（秒）
CACHE_TTL_SECONDS=3600
CACHE_NULL_TTL_SECONDS=30

# 统计查询范围（天）
STATS_DEFAULT_RANGE_DAYS=7
STATS_MAX_RANGE_DAYS=90

# 保留字黑名单（见 docs/API.md §5.2）
RESERVED_CODES=api,admin,actuator,health,favicon.ico,static,error