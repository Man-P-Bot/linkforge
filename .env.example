# LinkForge 本地环境变量
#
# 用法：复制本文件为 .env，按需修改后执行 docker compose up -d
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# ⚠️ .env 已被 .gitignore 忽略，禁止提交。本文件只放占位值，不放真实密钥。

# ---------- MySQL 8.4 ----------
# 仅本地开发使用；生产环境必须更换为强密码
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=linkforge
MYSQL_USER=linkforge
MYSQL_PASSWORD=change_me_app_password
# 宿主机映射端口。本机 MySQL80 服务已占用 3306，故改用 3307 避让。
# 容器内部端口恒为 3306；compose 网络内应用连接地址为 mysql:3306。
MYSQL_PORT=3307

# ---------- 应用数据源（唯一来源，不分 profile）----------
# 应用只认这一个 URL，由环境变量整体覆盖（12-Factor App），不做 profile 切换。
#   开发（应用跑在宿主机，连容器映射出的端口）：
#     jdbc:mysql://localhost:3307/linkforge?...
#   容器内（第 5 周 compose 中设置，应用与 MySQL 同网络）：
#     jdbc:mysql://mysql:3306/linkforge?...
# 端口是 3307 而非 3306，因为本机 3306 被宿主机的 MySQL80 占用（见 docs/DECISIONS.md DR-017）。
# ⚠️ URL 内使用 & 分隔参数；写入 .env 时不要加引号，否则引号会被当成值的一部分。
#
# allowPublicKeyRetrieval=true 仅本地开发使用（MySQL 8.4 caching_sha2_password 首次连接需获取公钥）。
# 生产环境应改为 useSSL=true 并配置证书，不要开 allowPublicKeyRetrieval。
#
# ⚠️ 时区：必须用 connectionTimeZone=UTC + forceConnectionTimeZoneToSession=true，
#    **不要用 serverTimezone=Asia/Shanghai**（docs/DECISIONS.md DR-032）：
#    1. serverTimeZone 参数在 Connector/J 8.0.23+ 已废弃；
#    2. forceConnectionTimeZoneToSession=true 会让驱动执行 SET time_zone='+00:00'，
#       数据库会话时区变成 UTC，于是 DEFAULT CURRENT_TIMESTAMP 生成的就是 UTC；
#    3. 若会话时区是本地（如 +08:00），数据库生成的 created_at 是本地墙上时钟，
#       应用再按 UTC 解释并加一次偏移，会产生**正好 8 小时**的双重换算。
#    应用层因此可以无条件把持久层的 LocalDateTime 当 UTC 处理（DR-027）。
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/linkforge?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8

# ---------- Redis 7.4 ----------
REDIS_PORT=6379
# 应用连接 Redis 的主机名。
#   开发（应用跑在宿主机）：localhost（连容器映射出的端口）
#   容器内（第 5 周 compose 中设置）：redis（服务名；localhost 会指向应用容器自身）
REDIS_HOST=localhost

# ---------- 应用（第 1 周起使用）----------
# Location / shortUrl 拼接用的对外基地址；缺失时应用启动失败（见 docs/DECISIONS.md DR-014）
SHORTLINK_BASE_URL=http://localhost:8080
APP_PORT=8080

# 后台接口鉴权 Token；仅本地开发占位值，禁止用于任何真实环境
ADMIN_API_TOKEN=change_me_local_dev_token

# 限流阈值（见 docs/API.md §11）
RATE_LIMIT_REDIRECT_PER_SEC=20
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_QUERY_PER_SEC=60
RATE_LIMIT_ADMIN_PER_MIN=30

# 缓存 TTL（秒）
CACHE_TTL_SECONDS=3600
CACHE_NULL_TTL_SECONDS=30

# 统计查询范围（天）
STATS_DEFAULT_RANGE_DAYS=7
STATS_MAX_RANGE_DAYS=90

# 保留字黑名单（见 docs/API.md §5.2）
RESERVED_CODES=api,admin,actuator,health,favicon.ico,static,error