# --- Build output ---
target/
build/
out/
bin/
*.class
*.jar
*.war

# --- Maven wrapper local repository (in-workspace, never committed) ---
.mvn-repo/

# --- Local scratch / backups (never commit) ---
.backup-*/
*.bak
*.orig
*.rej

# 原子写入的临时文件。
# ⚠️ setup-local.sh 生成 secret 时先写 <name>.tmp 再 mv —— 中途 Ctrl-C
#    会留下一个半截文件。这种文件绝不能进 git。
*.tmp

# Windows 路径里混进分号产生的空壳目录（如 `scripts;D/`、`results;D/`）。
# 根因：命令行里 `-v "D:/path;D:/path"` 这类写法被 shell 拆成了两段。
# 它们是空目录（git 本来就不跟踪），但会让 `ls` 与 `find` 变得莫名其妙，
# 也会让「哪些文件属于项目」这件事失去说服力。
*;*/

# --- IDE / editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp

# --- Logs / runtime ---
*.log
logs/
*.pid
*.hprof

# --- Local config & secrets (never commit) ---
.env
.env.*
!.env.example

# Docker secrets：真实凭据**绝不进 git**（docker inspect 看不到它们，
# 前提是走 secrets 挂载而不是环境变量）。
# 只保留 .example 模板。
docker/secrets/*
!docker/secrets/*.example
# scripts/run-local.ps1 自测时产生的临时副本
.env.runlocal-*
application-local.yml
application-local.yaml
application-local.properties
*-local.yml
*-local.properties

# --- Agent working directory (session memory / scratch, not project files) ---
# .workbuddy/ 下是 IDE 智能体的会话记忆与临时文件，与项目源码无关，
# 提交进去只会污染仓库历史（且记忆内容可能随会话变化，导致无意义的 diff）。
.workbuddy/

# --- Local infra data (bind mounts for MySQL/Redis) ---
data/
docker/mysql/data/
docker/redis/data/
*.rdb
*.aof

# --- Benchmark / report artifacts ---
# ⚠️ 整个压测产物目录都忽略：
#   results/codes.txt 是**每次压测重新生成**的语料，提交它会让下次压测误用旧数据；
#   根下的 cag.lua / fprate.txt 是验证脚本的临时文件，每次重建。
benchmark/

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
