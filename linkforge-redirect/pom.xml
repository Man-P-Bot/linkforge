<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>linkforge-redirect</artifactId>
  <name>LinkForge :: Redirect</name>
  <description>跳转链路：控制器、缓存实现、布隆过滤器、限流</description>

  <!--
    依赖规则（docs/DECISIONS.md DR-018）：
      redirect → core + stats   ✅
      redirect → admin          ❌ 禁止（由 ArchUnit 测试强制）
  -->
  <dependencies>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-stats</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Redis 客户端：发号器主路径用 Redis INCR（docs/DECISIONS.md DR-011），
      第 2 周起的跳转缓存也用它。只有 redirect 用 Redis，因此依赖加在本模块而不是 core。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      本地缓存（Caffeine）：跳转第1 层缓存（docs/ARCHITECTURE.md §10）。
      不引 Spring Cache 抽象 —— 本项目只有跳转一个缓存点，
      用 @Cacheable 的收益不足以抵消「注解不生效时静默退化成查库」的排查成本。
      缓存读写要精确控制（NegativeHit 不下沉、异常不缓存），显式调用更可控。
    -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!--
      字段级校验（@NotBlank/@Size/@Pattern/@Valid）。spring-boot-starter-web 不再传递
      引入校验实现，必须显式声明，否则 jakarta.validation.* 找不到。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Micrometer（Counter / MeterRegistry）：shortlink_id_conflict_total 指标（DR-022）。
      走 actuator starter 而不是单独引 micrometer-core —— 第 5 周本来就要暴露
      /actuator/prometheus 给 Prometheus 抓取，一次引入到位。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Prometheus 格式的指标注册表（第 5 周监控栈）。

      ⚠️ **为什么必须显式引入**：actuator starter 只带 micrometer-core，
      它**不包含**任何「把指标翻译成 Prometheus 文本格式」的实现。
      缺了它，/actuator/prometheus 端点会 404（端点存在但没有 registry）。

      ⚠️ **版本不写**：由 spring-boot-dependencies (Boot 3.5.8) 管理，
      与 actuator 带的 micrometer-core 版本严格一致 —— 版本错配会出现
      「NoSuchMethodError」这类运行期错误，而不是编译期错误。

      ⚠️ **加在这里而不是 app**：actuator 本来就在 redirect（它带 web starter），
      两者放一起才一致。app 依赖 redirect，会传递拿到本依赖。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 单测：发号器边界用例 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
