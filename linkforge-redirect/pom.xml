<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>linkforge-redirect</artifactId>
  <name>LinkForge :: Redirect</name>
  <description>跳转链路：控制器、缓存实现、布隆过滤器、限流</description>

  <!--
    依赖规则（docs/DECISIONS.md DR-018）：
      redirect → core + stats   ✅
      redirect → admin          ❌ 禁止（由 ArchUnit 测试强制）
  -->
  <dependencies>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-stats</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      Redis 客户端：发号器主路径用 Redis INCR（docs/DECISIONS.md DR-011），
      第 2 周起的跳转缓存也用它。只有 redirect 用 Redis，因此依赖加在本模块而不是 core。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      字段级校验（@NotBlank/@Size/@Pattern/@Valid）。spring-boot-starter-web 不再传递
      引入校验实现，必须显式声明，否则 jakarta.validation.* 找不到。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Micrometer（Counter / MeterRegistry）：shortlink_id_conflict_total 指标（DR-022）。
      走 actuator starter 而不是单独引 micrometer-core —— 第 5 周本来就要暴露
      /actuator/prometheus 给 Prometheus 抓取，一次引入到位。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- 单测：发号器边界用例 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
