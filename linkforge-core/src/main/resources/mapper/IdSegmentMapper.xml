<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  IdSegmentMapper —— id_segment 表的 SQL（docs/DATABASE.md §4.4）

  短码发号的降级路径：Redis 不可用时从这里取号段。
  区间边界由 com.linkforge.core.domain.IdSpace 统一定义：
    Redis      [100000, 1_000_000_000)
    数据库号段  [1_000_000_000, 62^7)
  因此本表初始 max_id = 999999999（发出的是 max_id + 1 = 1000000000），不是 100000。
-->
<mapper namespace="com.linkforge.core.infrastructure.persistence.IdSegmentMapper">

    <!--
      幂等插入：已存在则不覆盖。
      ⚠️ 不能用 INSERT ... ON DUPLICATE KEY UPDATE max_id = VALUES(max_id)：
      那会在每次启动时把 max_id 重置回初始值，导致已发出的号被重新发出（重复短码）。
    -->
    <insert id="insertIgnore">
        INSERT IGNORE INTO id_segment (biz_tag, max_id, step)
        VALUES (#{bizTag}, #{maxId}, #{step})
    </insert>

    <!--
      原子推进：只做 UPDATE，**不返回 max_id**。
      ⚠️ 必须拆成 update + select 两条，原因见 DR-042：
         MyBatis 的 <update> 返回的是**受影响行数**（本语句恒为 1），
         不是 max_id。原先把它声明成返回 long 并直接赋给 newLimit，
         于是 newLimit = 1，segmentStart = 1 - step + 1 = -998（负序号）。
         调用方 IdSegmentAllocator 在同一 REQUIRES_NEW 事务内先 update 再 select，
         InnoDB 行锁保证 select 读到的是自己那次 update 的结果。
    -->
    <update id="advanceMaxId">
        UPDATE id_segment
        SET max_id = max_id + step
        WHERE biz_tag = #{bizTag}
    </update>

    <!--
      读取推进后的 max_id。
      ⚠️ 必须在推进的同一事务内调用（REQUIRES_NEW），否则读到的可能是别的实例推进后的值。
    -->
    <select id="selectMaxId" resultType="long">
        SELECT max_id
        FROM id_segment
        WHERE biz_tag = #{bizTag}
    </select>

</mapper>
