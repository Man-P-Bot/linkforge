<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  StatsMapper —— link_stats_daily 表的 SQL（docs/DATABASE.md §4.3）

  为什么把 SQL 集中在 XML 而不是注解里：
    本项目要讲清楚的核心之一是「哪条 SQL 走哪个索引」，XML 便于把索引意图直接写在语句旁边。
  索引对应关系：
    uk_link_date_referer(link_id,stat_date,referer_domain) -> 两条 UPSERT 的冲突判定
    idx_stat_date(stat_date)                              -> 按日期范围查询（阶段 5 的后台查询用）

  ⚠️ 短码 -> 主键的映射不在这里：它查的是 short_link 表，
     语义属于「读短链」，因此放在 LinkMapper.selectIdsByShortCodes。
-->
<mapper namespace="com.linkforge.core.infrastructure.persistence.StatsMapper">

    <!--
      PV 累加：INSERT ... AS new ON DUPLICATE KEY UPDATE pv = link_stats_daily.pv + new.pv

      ⚠️ 为什么必须累加：每次落库携带的是「自上次落库以来新增的浏览量」，
      多次落库要叠加。若改成覆盖（pv = new.pv），刷新期间没被 flush 掉的增量
      会永远丢失。
      ⚠️ 左值必须写成 `link_stats_daily.pv`（表名限定）——
         写 `pv` 会报 "Column 'pv' in field list is ambiguous"
         （行别名 `new` 与目标表列名同名，必须用表名消歧）。

      ✅ **已用 `AS new` 别名语法**（2026-10-24 迁移）。
      MySQL 8.0.20 起 `VALUES(col)` 被标记 deprecated，未来 minor 版本可能移除 ——
      那会变成「生产启动即报错」的事故。详见下方 accumulatePvBatch 的说明
      与 docs/TROUBLESHOOTING.md T-010。

      ⚠️ referer_domain 固定 'direct'：当前阶段没有采集 referer，
      未来接入 referer 维度时需要把它加入唯一键的判定与本语句的取值。
    -->
    <!--
      ⚠️⚠️ 为什么用 `AS new` 别名语法，而不是 `VALUES(pv)`：

      MySQL 8.0.20 起，`ON DUPLICATE KEY UPDATE` 里的 `VALUES(col)` 函数
      **被标记为 deprecated**（MySQL 官方推荐改用行别名）：

        INSERT INTO t (a, b) VALUES (1, 2) AS new
        ON DUPLICATE KEY UPDATE b = t.b + new.b

      `VALUES()` 在 MySQL 8.4 上仍能执行（已实测），但未来 minor 版本可能移除 ——
      那会变成「生产启动即报错」的事故。提前改掉，成本几乎为零。

      ⚠️ 语义完全等价：`new.pv` 引用的是**正在插入的这一行**的 pv 值。
      多行 VALUES 时，逐行处理，每行的 `new` 指向当前行 —— 与 `VALUES(pv)` 一致。
      这点已由 StatsRepositoryMyBatisTest 的多行断言覆盖
      （PV 三次落库 5/3/2 -> 10；UV 落 5 -> 12 -> 8 -> 12）。

      ⚠️⚠️ **左值必须用「表名.列名」限定**：
        ON DUPLICATE KEY UPDATE pv = link_stats_daily.pv + new.pv
                                     ^^^^^^^^^^^^^^^^^^^^^^^^
      写成 `pv = pv + new.pv` 会报：
        Column 'pv' in field list is ambiguous
      原因：`AS new` 的行别名与**目标表的列名同名**，
      MySQL 无法判断左边的 `pv` 指的是表还是别名 —— 必须用表名消歧。
      （这正是 MySQL 官方文档里 `t.b + new.b` 那个例子的写法。）
    -->
    <insert id="accumulatePvBatch">
        INSERT INTO link_stats_daily (link_id, stat_date, pv, uv_estimated, referer_domain)
        VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{row.linkId}, #{row.statDate}, #{row.delta}, 0, 'direct')
        </foreach>
        AS new
        ON DUPLICATE KEY UPDATE
            pv = link_stats_daily.pv + new.pv
    </insert>

    <!--
      UV 合并：INSERT ... AS new ON DUPLICATE KEY UPDATE
              uv_estimated = GREATEST(link_stats_daily.uv_estimated, new.uv_estimated)

      ⚠️ 为什么用 GREATEST 而不是累加：
        HLL 的 PFCOUNT 返回的是「当日至今的独立访客估算」，**不是增量**。
        一分钟内 flush 一次、一天 1440 次，若用累加，同一个访客会被计 1440 遍。
        当日值只增不减，取 GREATEST 既是正确语义，也让重试天然幂等
        （重放同一个估算值不会把结果改坏）。

      ⚠️ 为什么不与 PV 合并成一条语句：
        PV 是累加语义、UV 是覆盖语义，合并后重试无法区分「PV 已成功、UV 失败」，
        重放整条语句会把 PV 重复累加。两条语句分开，才能做靶向重试
        （只重试失败的那一路）。见 StatsRepository 的 javadoc。
    -->
    <insert id="mergeUvBatch">
        INSERT INTO link_stats_daily (link_id, stat_date, pv, uv_estimated, referer_domain)
        VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{row.linkId}, #{row.statDate}, 0, #{row.estimate}, 'direct')
        </foreach>
        AS new
        ON DUPLICATE KEY UPDATE
            uv_estimated = GREATEST(link_stats_daily.uv_estimated, new.uv_estimated)
    </insert>

</mapper>
