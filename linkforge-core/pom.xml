<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>linkforge-core</artifactId>
  <name>LinkForge :: Core</name>
  <description>领域模型、仓储接口、跨模块共享的服务抽象（保持薄，不放具体实现）</description>

  <!--
    ⚠️ core 是唯一被所有业务模块依赖的模块，必须保持「薄」（docs/DECISIONS.md DR-018）：
       只放领域模型、仓储接口与共享服务抽象，**不得**引入 web / 缓存 / 限流 / 数据访问实现。
       因此这里只依赖 spring-boot-starter：连 JDBC 驱动都不放，
       仓储的具体实现（JDBC/JPA/MyBatis）在第 1 周 D2 决定后，加到使用它的模块里。
  -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
