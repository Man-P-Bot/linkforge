<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.linkforge</groupId>
    <artifactId>linkforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>linkforge-stats</artifactId>
  <name>LinkForge :: Stats</name>
  <description>统计：计数、按天聚合、定时批量落库</description>

  <!--
    依赖规则（docs/DECISIONS.md DR-018）：
      stats → core  ✅（stats 不得依赖 redirect / admin）
  -->
  <dependencies>
    <dependency>
      <groupId>com.linkforge</groupId>
      <artifactId>linkforge-core</artifactId>
    </dependency>

    <!-- Spring 上下文：@Component / @Value 注入队列与容量配置。
         不引 spring-boot-starter-*：统计模块只需要 context，
         不需要 web / data-redis（DR-018 的依赖约束仍成立）。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <!-- 指标：shortlink.stats.dropped 等。走 micrometer-core 而非 actuator starter——
         统计模块不该决定「指标通过什么端点暴露」，那是 app 层的事。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- Redis：阶段 2 起消费线程要写 shortlink:pv:* / shortlink:uv:* /死信队列。
         ⚠️ 不抽到 core：Spring Boot 单上下文共享 LettuceConnectionFactory，
         两个模块各引一份 starter 只是编译期依赖，**运行时仍然只有一个连接池**。
         （DR-058 阶段 2 已裁决） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 测试：JUnit 5 + AssertJ。scope=test，不进运行时依赖树。-->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
